// // This is your Prisma schema file,
// // learn more about it in the docs: https://pris.ly/d/prisma-schema

// // Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// 1. USERS & PROFILES
// =====================================================

enum UserRole {
  CUSTOMER
  EO
}

model Users{
  id String @id @default(uuid())
  username String @unique
  email String @unique
  passwordHash String
  role UserRole

  referralCode String @unique
  referredByUserId String?
  totalPoints Int @default(0)

  // Orang yang mengundang user ini (Atasan/Upline)
  referredByUser Users? @relation("UserReferral", fields: [referredByUserId], references: [id])
  
  // Daftar orang-orang yang diundang oleh user ini (Bawahan/Downline)
  invitedUsers Users[] @relation("UserReferral")

   // Tambahan dari tabel PointLot sebelumnya (agar relasi dua arahnya sinkron)
  pointLots         PointLots[] @relation("UserPoints")
  referredPointLots PointLots[] @relation("ReferredUserPoints")

  // relasi
  costumerProfiles CustomerProfiles[]
  organizerProfiles OrganizerProfiles[]
  coupons Coupons[]
  transactions Transactions[]
  paymentProofs PaymentProofs[]
  reviews Reviews[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@map("users")
}

model CustomerProfiles {
  id String @id @default(uuid())
  
  userId String
  users Users @relation(fields: [userId], references: [id])
 
  fullname String @db.VarChar(100)
  phoneNumber Int
  avatarUrl String @db.VarChar(500)
  dateOfBirth DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("costumerProfiles")
}

model OrganizerProfiles {
  id String @id @default(uuid())

  userId String
  users Users @relation(fields: [userId], references: [id])

  organizationName String @db.VarChar(150)

  // relasi
  events Events[]
  organizerBankAccounts OrganizerBankAccounts[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("organizer-profiles")
}


// =====================================================
// 2. CATEGORIES & EVENTS
// =====================================================

model Categories {
  id String @id @default(uuid())
  parentId String?

  name String @db.VarChar(100)
  slug String @db.VarChar(100) @unique

  // relasi
  events Events[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("categories")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventFormat {
  SPECTATOR
  PARTICIPANT
}

enum TypePrice {
  FREE
  PAID
}

model Events {
  id String @id @default(uuid())
  slug String @unique @db.VarChar(250)
  organizerId String
  organizer OrganizerProfiles @relation(fields: [organizerId], references: [id])
  
  categoryId String
  categories Categories @relation(fields: [categoryId], references: [id])

  title String @db.VarChar(200)
  description String @db.VarChar(2000)
  location String @db.VarChar(300)
  format EventFormat
  typePrice TypePrice
  price Decimal @db.Decimal(15,2)
  coverImageUrl String? @db.Text

  quota Int
  startsAt DateTime?
  EndsAt DateTime?

  // relasi
  eventVoucher EventVoucher[]
  transactions Transactions[]
  reviews Reviews[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  
  
  @@index([typePrice])
  @@index([format])
  @@index([location])
  @@index([organizerId])
  @@index([categoryId])
  @@map("events")
}

// =====================================================
// 3. EVENT VOUCHERS
// Voucher dibuat EO untuk event miliknya, misal: 'DISKON1010'
// =====================================================

enum DiscountType {
  PERCENTAGE
}

model EventVoucher {
  id String @id @default(uuid())
  eventId String
  events Events @relation(fields: [eventId],references: [id])

  code String @db.VarChar(50)
  discountPercentage Decimal @db.Decimal()
  quota Int
  startAt DateTime
  endAt DateTime //menggantikan expiresAt
  isActive Boolean 

  // relasi
  transactions Transactions[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([eventId, code])
  @@map("event-voucher")
}

// =====================================================
// 4. SYSTEM COUPONS / REWARD COUPONS
// Kupon reward dari aplikasi berlaku untuk semua event, misal : KUPON-XYZ123
// =====================================================

model Coupons {
  id String @id @default(uuid())
  userId String
  users Users @relation(fields: [userId], references: [id])

  code String   @unique // Harus unik global agar tidak tertukar
  discountPercentage Decimal
  quota Int      // Kuota pemakaian untuk user ini (misal: 1)
  startAt DateTime
  endAt DateTime // Menggantikan expiresAt
  isActive Boolean  @default(true)

  // relasi
  transactions Transactions[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("coupons")
}


// =====================================================
// 5. REFERRAL POINTS
// Setiap perolehan poin mempunyai masa berlaku sendiri
// =====================================================
enum PointLotStatus {
  AVAILABLE
  PARTIALLY_USED
  FULLY_USED
  EXPIRED
}

model PointLots{
  id String @id @default(uuid())
  userId String @map("user_id")
  user Users  @relation("UserPoints", fields: [userId], references: [id])
  
  referredUserId String?  // Pakai '?' karena di gambar Anda nilainya [null]
  referredUser Users? @relation("ReferredUserPoints", fields: [referredUserId], references: [id])

  pointsRemaining Int
  status PointLotStatus @default(AVAILABLE)

  creditedAt DateTime @default(now())
  expiresAt DateTime

  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, expiresAt])
  @@map("point-lots")
}

// =====================================================
// 6. EO BANK ACCOUNTS FOR MANUAL TRANSFERS
// =====================================================

model OrganizerBankAccounts {
  id String @id @default(uuid())
  organizerId String
  organizer OrganizerProfiles @relation(fields: [organizerId], references: [id])

  bankName String @db.VarChar(50)
  accountNumber Int
  accountHolder String @db.VarChar(100)
  isActive Boolean @default(false)

  // relasi
  transactions Transactions[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("organizer-bank-accounts")
}

// =====================================================
// 7. TRANSACTIONS & PAYMENT
// =====================================================

enum TransactionStatus {
  WAITING_FOR_PAYMENT
  WAITING_FOR_CONFIRMATION
  PAID
  REJECTED
  EXPIRED
  CANCELLED
}

model Transactions {
  id String @id @default(uuid())
  customerId String
  users Users @relation(fields: [customerId], references: [id])

  bankAccountId String
  bankEo OrganizerBankAccounts @relation(fields: [bankAccountId], references: [id])

  eventId String
  events Events @relation(fields: [eventId], references: [id])

  eventVoucherId String?
  eventVoucher EventVoucher? @relation(fields: [eventVoucherId], references: [id])

  userCouponId String?
  coupons Coupons? @relation(fields: [userCouponId], references: [id])

  // --- KOLOM KUANTITAS & HARGA TIKET LANGSUNG DI SINI ---
  quantity        Int     // Jumlah tiket yang dibeli user (misal: 3)
  ticketPrice     Decimal @db.Decimal(15, 2) // Harga 1 tiket saat dibeli ( snapshot harga )
  
  transactionCode String @db.VarChar(50) @unique
  subtotal Decimal @db.Decimal(15,2)
  voucherDiscount Decimal @db.Decimal(15,2) @default(0)
  couponDiscount Decimal @db.Decimal(15,2) @default(0)
  pointUsed Int @default(0)
  pointDiscount Decimal  @db.Decimal(15,2) @default(0)
  finalAmount Decimal  @db.Decimal(15,2)

  status TransactionStatus @default(WAITING_FOR_PAYMENT)

  // Dibuat opsional (?) agar bisa bernilai null sebelum alur logistiknya tercapai
  paymentDeadline DateTime?
  confirmationDeadline DateTime?
  submittedProofAt DateTime?
  confirmedAt DateTime?
  rejectedAt DateTime?
  expiredAt DateTime?
  cancelledAt DateTime?

  // relasi
  paymentProofs PaymentProofs[]
  tickets Tickets[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

enum PaymentProofDecision {
  PENDING
  ACCEPTED
  REJECTED
}

model PaymentProofs {
  id String @id @default(uuid())
  transactionId String
  transactions Transactions @relation(fields: [transactionId], references: [id])

  storagePath String @db.VarChar(500) //upload foto
  uploadedAt DateTime @default(now())
  
  reviewedBy String
  eo Users @relation(fields: [reviewedBy], references: [id])
  reviewedAt DateTime?

  decision PaymentProofDecision @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("payment-proofs")
}

// =====================================================
// 8. DIGITAL TICKETS
// ID tiket adalah UUID; tidak ada QR Code atau check-in
// =====================================================

enum TicketStatus {
  VALID
  VOID
}

model Tickets {
  id String @id @default(uuid())
  transactionsId String
  Transactions Transactions @relation(fields: [transactionsId], references: [id])
  status TicketStatus @default(VALID)
  
  issuedAt DateTime //diterbitkan pada

  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("tickets")
}

// =====================================================
// 9. REVIEWS & RATINGS
// =====================================================

model Reviews {
  id String @id @default(uuid())
  customerId String
  users Users @relation(fields: [customerId], references: [id])

  eventId String
  events Events @relation(fields: [eventId],references: [id])

  rating Int
  comment String @db.VarChar(1000)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("reviews")
}




